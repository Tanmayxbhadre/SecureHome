<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build only: plain HTTP to a relay on this Mac (via adb reverse), and fake SMS from adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- android.permission.DUMP: only adb's shell user holds it, so other apps can't inject SMS. -->
        <receiver
            android:name=".sms.DebugSmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.tanmay.securehome.DEBUG_SMS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
